      "permanent": false
    },
    {
      "source": "/service/:path*",
      "destination": "/book-a-call/index.html?interest=custom",
      "permanent": false
    },
    {
      "source": "/growth/:path*",
      "destination": "/?section=packages",
      "permanent": false
    },
    {
      "source": "/social-growth/:path*",
      "destination": "/?section=packages",
      "permanent": false
    },
    {
      "source": "/web-development/:path*",
