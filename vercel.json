      "permanent": false
    },
    {
      "source": "/cart/:path*",
      "destination": "/book-a-call/index.html",
      "permanent": false
    },
    {
      "source": "/checkout/:path*",
      "destination": "/book-a-call/index.html",
      "permanent": false
    },
    {
      "source": "/my-account/:path*",
      "destination": "/book-a-call/index.html",
      "permanent": false
    },
    {
      "source": "/case-studies/:path*",
      "destination": "/?section=work",
